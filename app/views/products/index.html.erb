<h1>商品一覧</h1>

<p><%= link_to "商品を登録する", new_product_path %></p>

<% if @products.empty? %>
  <p>登録されている商品はありません。</p>
<% else %>
  <table border="1">
    <thead>
      <tr>
        <th>商品名</th>
        <th>価格</th>
        <th>カートに追加</th>
        <th>削除</th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr>
          <td><%= product.name %></td>
          <td><%= yen(product.price) %></td>
          <td>
            <%= form_with url: cart_items_path do |f| %>
              <%= f.hidden_field :product_id, value: product.id %>
              <%= f.number_field :qty, value: 1, min: 1 %>
              <%= f.submit "カートに入れる" %>
            <% end %>
          </td>
          <td>
            <%= button_to "削除", product_path(product), method: :delete,
                  form: { data: { turbo_confirm: "「#{product.name}」を削除しますか？" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
