<h1>商品登録</h1>

<% if @product.errors.any? %>
  <ul>
    <% @product.errors.each do |error| %>
      <li><%= error.message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @product do |f| %>
  <p>
    <%= f.label :name, "商品名" %><br>
    <%= f.text_field :name %>
  </p>
  <p>
    <%= f.label :price, "価格（円）" %><br>
    <%= f.number_field :price, min: 0 %>
  </p>
  <p><%= f.submit "登録する" %></p>
<% end %>

<p><%= link_to "商品一覧に戻る", products_path %></p>
