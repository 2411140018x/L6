<h1>ショッピングカート</h1>

<% if @cart_items.empty? %>
  <p>カートに商品は入っていません。</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>商品名</th>
        <th>価格</th>
        <th>数量</th>
        <th>小計</th>
        <th>削除</th>
      </tr>
    </thead>
    <tbody>
      <% @cart_items.each do |item| %>
        <tr>
          <td><%= item.product.name %></td>
          <td class="num"><%= yen(item.product.price) %></td>
          <td class="num"><%= item.qty %></td>
          <td class="num"><%= yen(item.subtotal) %></td>
          <td><%= button_to "削除", cart_item_path(item), method: :delete %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <th colspan="2">合計</th>
        <th class="num"><%= @cart.total_qty %></th>
        <th class="num"><%= yen(@cart.total_price) %></th>
        <th></th>
      </tr>
    </tfoot>
  </table>
<% end %>

<p><%= link_to "買い物を続ける", products_path %></p>
